# Block dependency lifecycle scripts (postinstall etc.) on install — supply-chain
# hardening. This package has ZERO runtime dependencies; its dev deps need no build
# scripts. It also means NOTHING runs on `npm pack` / `npm publish` (no prepack, no
# prepublishOnly): `build` runs explicitly via `npm run build`, and the package is
# published only by .github/workflows/publish.yml (package.json `private` refuses a
# manual `npm publish`).
ignore-scripts=true
